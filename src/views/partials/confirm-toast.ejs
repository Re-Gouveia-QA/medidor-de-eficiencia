<div id="confirmToast" class="confirm-toast card sketch-edge" role="alertdialog" aria-modal="true" aria-live="assertive" aria-label="Confirmação">
  <span class="confirm-toast-icon"><%- include('./icon', { name: 'alert-triangle', size: 22 }) %></span>
  <div class="confirm-toast-body">
    <p class="confirm-toast-message"></p>
    <div class="confirm-toast-actions">
      <button type="button" class="btn btn-ghost btn-sm sketch-edge sketch-hover confirm-toast-cancel">Cancelar</button>
      <button type="button" class="btn btn-danger btn-sm sketch-edge sketch-hover confirm-toast-confirm">Confirmar</button>
    </div>
  </div>
</div>
