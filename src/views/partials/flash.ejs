<% if (typeof success !== 'undefined' && success.length) { %>
  <div class="alert sketch-edge alert-success">
    <%- include('./icon', { name: 'check', size: 20, color: 'var(--accent-green)' }) %>
    <div><%= success[0] %></div>
  </div>
<% } %>
<% if (typeof error !== 'undefined' && error.length) { %>
  <div class="alert sketch-edge alert-error">
    <%- include('./icon', { name: 'alert-triangle', size: 20, color: 'var(--accent-red)' }) %>
    <div><%= error[0] %></div>
  </div>
<% } %>
