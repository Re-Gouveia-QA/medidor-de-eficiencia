<section class="marketing-hero">
  <%
    /* Título quebrado em 2 linhas de propósito (chaves titleLine1/titleLine2), não deixado pro
       wrap natural do navegador: o sublinhado à mão é um <svg> posicionado em % relativo ao bloco
       inline-block do título (mesma técnica de .login-hero-title) — com o texto inteiro num só
       inline-block, um wrap imprevisível (depende do viewport/tradução) faz o sublinhado, que
       assume ocupar a largura da ÚLTIMA linha, ficar solto no meio do bloco de 2 linhas em vez de
       embaixo do texto. Forçando a quebra e isolando só a 2ª linha no próprio inline-block
       (.marketing-hero-title-accent), o sublinhado sempre acompanha exatamente essa linha. */
  %>
  <%
    /* Marca d'água decorativa (relógio gigante, bem apagado) — só atmosfera/profundidade, sem
       concorrer com o texto; assimétrica de propósito (cortada na borda, não centralizada) pra
       quebrar a monotonia de "tudo empilhado e centralizado" do resto da página. */
  %>
  <svg class="marketing-hero-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true" focusable="false">
    <path d="M12 21a9 9 0 100-18 9 9 0 000 18zM12 7v5l3 3" />
  </svg>
  <h1 class="marketing-hero-title sketch-in" style="--stagger-index: 0;">
    <%= t('marketing.hero.titleLine1') %><br />
    <span class="marketing-hero-title-accent">
      <%= t('marketing.hero.titleLine2') %>
      <svg class="title-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
  </h1>
  <p class="marketing-hero-subtitle sketch-in" style="--stagger-index: 1;"><%= t('marketing.hero.subtitle') %></p>
  <div class="marketing-hero-ctas sketch-in" style="--stagger-index: 2;">
    <span class="marketing-hero-cta-doodle" aria-hidden="true">
      <svg viewBox="0 0 60 40" preserveAspectRatio="none" focusable="false">
        <path d="M4 4 Q 10 30, 40 32 T 54 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
        <path d="M46 18 L55 25 L44 28 Z" fill="currentColor" />
      </svg>
      <span><%= t('marketing.hero.ctaDoodle') %></span>
    </span>
    <a class="btn btn-primary btn-lg sketch-edge sketch-hover" href="/register"><%= t('marketing.hero.primaryCta') %></a>
    <a class="btn btn-secondary btn-lg sketch-edge sketch-hover" href="/login"><%= t('marketing.hero.secondaryCta') %></a>
  </div>
</section>

<%
  /* Abaixo da dobra: entrada por scroll (scroll-reveal.js), não no carregamento — diferente do
     hero acima (sketch-in direto). data-scroll-reveal marca os elementos que o script observa;
     .scroll-reveal (opacity: 0) é a classe "escondida" trocada por sketch-in quando a seção entra
     na viewport. Sem JS/com prefers-reduced-motion, scroll-reveal.js remove .scroll-reveal na
     hora, deixando tudo visível sem animação nenhuma. */
%>
<%
  /* Faixa cheia (full-bleed, quebra o max-width:960px do .marketing-content) com fundo --surface
     — cria uma "zona" visual distinta em vez de mais uma seção sobre o mesmo fundo de papel do
     resto da página (ver crítica: antes disso, a página inteira era um bloco monótono de cima a
     baixo). .marketing-whatis-inner recentraliza o conteúdo na coluna de 960px de novo. */
%>
<section class="marketing-section marketing-whatis">
  <div class="marketing-whatis-inner">
    <h2 class="marketing-section-heading scroll-reveal" data-scroll-reveal style="--stagger-index: 0;"><%= t('marketing.whatIsIt.heading') %></h2>
    <div class="grid-menu marketing-features">
      <div class="card sketch-edge section-blue marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 1;">
        <%- include('../partials/icon', { name: 'plus', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.activities.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.activities.description') %></p>
      </div>
      <div class="card sketch-edge section-red marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 2;">
        <%- include('../partials/icon', { name: 'tag', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.categories.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.categories.description') %></p>
      </div>
      <div class="card sketch-edge section-yellow marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 3;">
        <%- include('../partials/icon', { name: 'star', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.reports.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.reports.description') %></p>
      </div>
    </div>
  </div>
</section>

<%
  /* Maneiras criativas de usar — o coração do pedido original desta home. Cada caso de uso cita
     uma feature real e verificável no código (nunca uma promessa vazia de marketing): valor por
     categoria (freelancer/orçamento), tempoDesejadoMin (estudante), duracaoPadraoMin (exercício),
     "dias registrados" do relatório (hábito/streak), atividade em andamento (foco). Cores
     cicladas pelas 4 "canetas" de acento. Tilt por item (não só i % 2 alternado) — valores
     variados de propósito, não uma progressão regular, pra parecer notas espalhadas à mão em vez
     de uma grade com leve inclinação uniforme; deliberadamente diferente da grade centralizada e
     uniforme da seção anterior (variedade de composição entre seções). */
  const useCases = [
    { icon: 'tag', color: 'section-blue', key: 'freelancer', tilt: '-0.8deg' },
    { icon: 'calendar', color: 'section-green', key: 'student', tilt: '0.6deg' },
    { icon: 'tag', color: 'section-yellow', key: 'budget', tilt: '-0.5deg' },
    { icon: 'clock', color: 'section-red', key: 'exercise', tilt: '0.9deg' },
    { icon: 'star', color: 'section-blue', key: 'habit', tilt: '-0.7deg' },
    { icon: 'eye', color: 'section-green', key: 'focus', tilt: '0.5deg' },
  ];
%>
<section class="marketing-section marketing-usecases">
  <h2 class="marketing-section-heading scroll-reveal" data-scroll-reveal style="--stagger-index: 0;"><%= t('marketing.useCases.heading') %></h2>
  <div class="marketing-usecases-grid">
    <% useCases.forEach((useCase, i) => { %>
      <div class="card sketch-edge <%= useCase.color %> marketing-usecase scroll-reveal"
           data-scroll-reveal
           style="--tilt: <%= useCase.tilt %>; --stagger-index: <%= i + 1 %>; transform: rotate(var(--tilt));">
        <div class="card-heading">
          <%- include('../partials/icon', { name: useCase.icon, size: 22 }) %>
          <h3 class="card-title"><%= t(`marketing.useCases.${useCase.key}.title`) %></h3>
        </div>
        <p class="muted"><%= t(`marketing.useCases.${useCase.key}.description`) %></p>
      </div>
    <% }) %>
  </div>
</section>

<%
  /* CTA final — ecoa o hero (mesmos botões/textos, marketing.hero.primaryCta/secondaryCta, não
     chaves novas) fechando o "loop" da página pra quem leu até aqui sem converter no topo. */
%>
<section class="marketing-section marketing-final-cta sketch-edge scroll-reveal" data-scroll-reveal style="--stagger-index: 0;">
  <div class="washi-tape" aria-hidden="true"></div>
  <h2 class="marketing-section-heading"><%= t('marketing.finalCta.heading') %></h2>
  <div class="marketing-hero-ctas">
    <a class="btn btn-primary btn-lg sketch-edge sketch-hover" href="/register"><%= t('marketing.hero.primaryCta') %></a>
    <a class="btn btn-secondary btn-lg sketch-edge sketch-hover" href="/login"><%= t('marketing.hero.secondaryCta') %></a>
  </div>
</section>
