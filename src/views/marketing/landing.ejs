<section class="marketing-hero">
  <%
    /* Título quebrado em 2 linhas de propósito (chaves titleLine1/titleLine2), não deixado pro
       wrap natural do navegador: o sublinhado à mão é um <svg> posicionado em % relativo ao bloco
       inline-block do título (mesma técnica de .login-hero-title) — com o texto inteiro num só
       inline-block, um wrap imprevisível (depende do viewport/tradução) faz o sublinhado, que
       assume ocupar a largura da ÚLTIMA linha, ficar solto no meio do bloco de 2 linhas em vez de
       embaixo do texto. Forçando a quebra e isolando só a 2ª linha no próprio inline-block
       (.marketing-hero-title-accent), o sublinhado sempre acompanha exatamente essa linha. */
  %>
  <%
    /* Marca d'água decorativa (relógio gigante, bem apagado) — só atmosfera/profundidade, sem
       concorrer com o texto; assimétrica de propósito (cortada na borda, não centralizada) pra
       quebrar a monotonia de "tudo empilhado e centralizado" do resto da página. */
  %>
  <svg class="marketing-hero-watermark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.6" aria-hidden="true" focusable="false">
    <path d="M12 21a9 9 0 100-18 9 9 0 000 18zM12 7v5l3 3" />
  </svg>
  <h1 class="marketing-hero-title sketch-in" style="--stagger-index: 0;">
    <%= t('marketing.hero.titleLine1') %><br />
    <span class="marketing-hero-title-accent">
      <%= t('marketing.hero.titleLine2') %>
      <svg class="title-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
  </h1>
  <p class="marketing-hero-subtitle sketch-in" style="--stagger-index: 1;"><%= t('marketing.hero.subtitle') %></p>
  <div class="marketing-hero-ctas sketch-in" style="--stagger-index: 2;">
    <a class="btn btn-primary btn-lg sketch-edge sketch-hover" href="/register"><%= t('marketing.hero.primaryCta') %></a>
    <a class="btn btn-secondary btn-lg sketch-edge sketch-hover" href="/login"><%= t('marketing.hero.secondaryCta') %></a>
  </div>
  <%
    /* Antes apontava pro botão (setinha ao lado do CTA); agora vira uma dica de "role pra baixo",
       apontando pra seção seguinte ("O que você pode fazer") — reposicionada abaixo dos botões,
       centralizada, com o traço na vertical em vez de na diagonal. */
  %>
  <span class="marketing-hero-scroll-cue sketch-in" style="--stagger-index: 3;" aria-hidden="true">
    <span><%= t('marketing.hero.ctaDoodle') %></span>
    <svg viewBox="0 0 40 50" focusable="false">
      <path d="M20 2 V36" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      <path d="M9 27 L20 44 L31 27 Z" fill="currentColor" />
    </svg>
  </span>
</section>

<%
  /* Abaixo da dobra: entrada por scroll (scroll-reveal.js), não no carregamento — diferente do
     hero acima (sketch-in direto). data-scroll-reveal marca os elementos que o script observa;
     .scroll-reveal (opacity: 0) é a classe "escondida" trocada por sketch-in quando a seção entra
     na viewport. Sem JS/com prefers-reduced-motion, scroll-reveal.js remove .scroll-reveal na
     hora, deixando tudo visível sem animação nenhuma. */
%>
<%
  /* Faixa cheia (full-bleed, quebra o max-width:960px do .marketing-content) com fundo --surface
     — cria uma "zona" visual distinta em vez de mais uma seção sobre o mesmo fundo de papel do
     resto da página (ver crítica: antes disso, a página inteira era um bloco monótono de cima a
     baixo). .marketing-whatis-inner recentraliza o conteúdo na coluna de 960px de novo. */
%>
<section class="marketing-section marketing-whatis">
  <div class="marketing-whatis-inner">
    <h2 class="marketing-section-heading scroll-reveal" data-scroll-reveal style="--stagger-index: 0;"><%= t('marketing.whatIsIt.heading') %></h2>
    <div class="grid-menu marketing-features">
      <div class="card sketch-edge section-blue marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 1;">
        <%- include('../partials/icon', { name: 'plus', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.activities.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.activities.description') %></p>
      </div>
      <div class="card sketch-edge section-red marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 2;">
        <%- include('../partials/icon', { name: 'tag', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.categories.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.categories.description') %></p>
      </div>
      <div class="card sketch-edge section-yellow marketing-feature scroll-reveal" data-scroll-reveal style="--stagger-index: 3;">
        <%- include('../partials/icon', { name: 'star', size: 32 }) %>
        <h3 class="card-title"><%= t('marketing.whatIsIt.reports.title') %></h3>
        <p class="muted"><%= t('marketing.whatIsIt.reports.description') %></p>
      </div>
    </div>
  </div>
</section>

<%
  /* Benefícios (por que usar, não só o que dá pra fazer) — padrão "left-right": linhas alternando
     visual/texto de lado (nth-child(even) inverte via row-reverse em CSS), diferente da grade
     centralizada da seção anterior e do carrossel horizontal da seguinte — 4ª composição distinta
     da página. Cada benefício ainda cita algo real e verificável no código (mesmo critério dos
     use cases abaixo): relatório (dias/horas/distribuição), duração calculada automaticamente,
     categoria com cor/meta/valor livres — não promessas genéricas de marketing. */
  const benefits = [
    { color: 'section-blue', key: 'clarity' },
    { color: 'section-green', key: 'simplicity' },
    { color: 'section-yellow', key: 'flexibility' },
  ];
  /* Ilustrações maiores (não ícones de 24px do catálogo de icon.ejs) — pedido explícito de
     substituir ícones por imagens nesta seção. Ficam inline aqui (não em icon.ejs, que é o
     catálogo de glifos pequenos reutilizados no app inteiro) porque são cenas específicas desta
     seção, mesmo padrão já usado na seta de "comece por aqui" do hero. Mesma linguagem visual do
     resto do app: stroke="currentColor" (herda a cor de .section-blue/green/yellow via
     ".card.section-* svg" em styles.css) + filtro url(#sketch-rough-icon) pro mesmo tremor
     "à mão" dos ícones normais. */
  const benefitIllustrations = {
    clarity:
      '<svg viewBox="0 0 64 64" width="72" height="72" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="filter: url(#sketch-rough-icon)"><path d="M8 48V38M20 48V30M32 48V22" /><circle cx="42" cy="26" r="12" /><path d="M50.5 34.5L58 42" /></svg>',
    simplicity:
      '<svg viewBox="0 0 64 64" width="72" height="72" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="filter: url(#sketch-rough-icon)"><path d="M6 20h13M6 32h18M6 44h11" /><circle cx="42" cy="32" r="16" /><path d="M35 32.5l5 5 10-10.5" /></svg>',
    flexibility:
      '<svg viewBox="0 0 64 64" width="72" height="72" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" style="filter: url(#sketch-rough-icon)"><path d="M8 50c6-15 19-24 33-27" /><path d="M39 25l11-11 5 5-11 11z" /><path d="M50 14l5 5" /><circle cx="8" cy="50" r="2.2" fill="currentColor" stroke="none" /></svg>',
  };
%>
<section class="marketing-section marketing-benefits">
  <h2 class="marketing-section-heading scroll-reveal" data-scroll-reveal style="--stagger-index: 0;"><%= t('marketing.benefits.heading') %></h2>
  <div class="marketing-benefits-list">
    <% benefits.forEach((benefit, i) => { %>
      <div class="marketing-benefit-row scroll-reveal" data-scroll-reveal style="--stagger-index: <%= i + 1 %>;">
        <div class="marketing-benefit-visual card sketch-edge <%= benefit.color %>" style="transform: rotate(<%= i % 2 ? '0.8deg' : '-0.8deg' %>);">
          <%- benefitIllustrations[benefit.key] %>
        </div>
        <div class="marketing-benefit-text">
          <h3 class="card-title"><%= t(`marketing.benefits.${benefit.key}.title`) %></h3>
          <p class="muted"><%= t(`marketing.benefits.${benefit.key}.description`) %></p>
        </div>
      </div>
    <% }) %>
  </div>
</section>

<%
  /* Maneiras criativas de usar — o coração do pedido original desta home. Cada caso de uso cita
     uma feature real e verificável no código (nunca uma promessa vazia de marketing): valor por
     categoria (freelancer/orçamento), tempoDesejadoMin (estudante), duracaoPadraoMin (exercício),
     "dias registrados" do relatório (hábito/streak), atividade em andamento (foco). Cores
     cicladas pelas 4 "canetas" de acento. Sem tilt fixo por item (removido): o efeito 3D
     "coverflow" de marketing-slider.js já cuida da inclinação de cada card dinamicamente,
     conforme a distância até o centro do carrossel — um tilt estático por cima ficaria
     conflitando com o rotateY calculado no scroll. */
  const useCases = [
    { icon: 'tag', color: 'section-blue', key: 'freelancer' },
    { icon: 'calendar', color: 'section-green', key: 'student' },
    { icon: 'tag', color: 'section-yellow', key: 'budget' },
    { icon: 'clock', color: 'section-red', key: 'exercise' },
    { icon: 'star', color: 'section-blue', key: 'habit' },
    { icon: 'eye', color: 'section-green', key: 'focus' },
  ];
%>
<section class="marketing-section marketing-usecases">
  <h2 class="marketing-section-heading scroll-reveal" data-scroll-reveal style="--stagger-index: 0;"><%= t('marketing.useCases.heading') %></h2>
  <%
    /* Dica de rolagem sempre visível (não só um "peek" de card cortado na borda, que depende da
       largura exata da viewport coincidir ou não com um número exato de cards — em várias larguras
       o último card cabe perfeitamente e não sobra nenhuma pista visual de que há mais conteúdo à
       direita). Simples e confiável em qualquer tamanho de tela, sem cálculo de layout. */
  %>
  <%
    /* Setas de navegação (marketing-slider.js) — controle explícito além do gesto de arrastar,
       reaproveitando chevron-right (só rotacionado 180deg pra virar "anterior", mesma técnica já
       usada em .back-btn). JS faz scrollBy com behavior:'smooth' no .marketing-usecases-grid, que
       já tem scroll-snap-type: x mandatory — a "animação" do slider é o scroll nativo suave, não
       uma reimplementação própria de easing/frames. */
  %>
  <div class="marketing-usecases-controls">
    <p class="marketing-usecases-hint muted scroll-reveal" data-scroll-reveal style="--stagger-index: 0.5;">
      <%- include('../partials/icon', { name: 'arrow-right', size: 16 }) %>
      <%= t('marketing.useCases.scrollHint') %>
    </p>
    <div class="marketing-usecases-arrows">
      <button type="button" class="icon-btn btn-sm sketch-edge sketch-hover btn-secondary marketing-slider-prev" aria-label="<%= t('marketing.useCases.prevAriaLabel') %>" disabled>
        <%- include('../partials/icon', { name: 'chevron-right', size: 18 }) %>
      </button>
      <button type="button" class="icon-btn btn-sm sketch-edge sketch-hover btn-secondary marketing-slider-next" aria-label="<%= t('marketing.useCases.nextAriaLabel') %>">
        <%- include('../partials/icon', { name: 'chevron-right', size: 18 }) %>
      </button>
    </div>
  </div>
  <%
    /* Carrossel horizontal (redesign a partir de mockup de referência): os cards entram direto
       via sketch-in no carregamento (como o hero), NÃO por scroll-reveal.js. Motivo: scroll-reveal
       observa a posição real do elemento na viewport (IntersectionObserver), e num carrossel
       horizontal a maioria dos cards nasce fora da área visível NO EIXO X (cortada pelo
       overflow-x do carrossel), não no eixo Y — só entrariam em interseção quando o usuário
       arrastasse o carrossel horizontalmente. Muita gente nunca descobre esse gesto rolando só a
       página verticalmente, e os cards ficariam presos em opacity:0 pra sempre. sketch-in direto
       evita esse buraco de conteúdo invisível: a animação roda fora de tela (a seção ainda nem
       apareceu), então quando o usuário chega até aqui os cards já estão parados, visíveis. */
  %>
  <div class="marketing-usecases-grid">
    <% useCases.forEach((useCase, i) => { %>
      <div class="card sketch-edge <%= useCase.color %> marketing-usecase sketch-in"
           style="--stagger-index: <%= i %>;">
        <div class="card-heading">
          <%
            /* Chip neutro (--paper) atrás do ícone: os cards agora têm fundo colorido (post-it,
               ver fix f938512), e o ícone usa a mesma cor cíclica de acento (useCase.color) —
               em alguns pares isso resultava em baixo contraste (ex.: ícone azul sobre card azul).
               Um fundo sempre neutro garante o mesmo contraste ícone/fundo dos outros usos desse
               ícone no app (ex.: cards de "o que você pode fazer" acima), não importa a cor do
               post-it embaixo. */
          %>
          <span class="usecase-icon-chip">
            <%- include('../partials/icon', { name: useCase.icon, size: 18 }) %>
          </span>
          <h3 class="card-title"><%= t(`marketing.useCases.${useCase.key}.title`) %></h3>
        </div>
        <p class="muted"><%= t(`marketing.useCases.${useCase.key}.description`) %></p>
      </div>
    <% }) %>
  </div>
</section>
