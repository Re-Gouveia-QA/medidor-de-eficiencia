<div class="page-header">
  <%- include('../partials/page-header', { title: 'Categorias', backHref: '/' }) %>
  <a class="btn btn-primary sketch-edge sketch-hover" href="/categories/new">
    <%- include('../partials/icon', { name: 'plus', size: 16 }) %> Nova categoria
  </a>
</div>

<% if (categorias.length === 0) { %>
  <p class="muted">Você ainda não tem categorias. Crie a primeira para começar a registrar atividades.</p>
<% } else { %>
  <div class="grid-menu">
    <% categorias.forEach((c, i) => { %>
      <div class="card sketch-edge" style="--tilt: <%= i % 2 ? '0.6deg' : '-0.6deg' %>; transform: rotate(var(--tilt));">
        <div class="card-heading">
          <span class="color-dot" style="background: <%= c.cor %>" aria-hidden="true"></span>
          <h3 class="card-title"><%= c.nome %></h3>
        </div>
        <% if (c.descricao) { %><p class="muted"><%= c.descricao %></p><% } %>
        <% if (c.tempoDesejadoMin || c.duracaoPadraoMin || c.possuiValor) { %>
          <div class="badge-row">
            <% if (c.tempoDesejadoMin) { %><span class="badge sketch-edge badge-blue">Meta: <%= c.tempoDesejadoMin %> min</span><% } %>
            <% if (c.duracaoPadraoMin) { %><span class="badge sketch-edge badge-neutral">Duração: <%= c.duracaoPadraoMin %> min</span><% } %>
            <% if (c.possuiValor) { %>
              <span class="badge sketch-edge badge-yellow"><%= c.valorLabel || 'Valor' %><% if (c.valorPadrao) { %> · padrão: <%= formatNumber(c.valorPadrao) %><% } %></span>
            <% } %>
          </div>
        <% } %>
        <p class="muted"><%= c._count.atividades %> atividade(s)</p>
        <div class="card-footer">
          <a class="btn btn-secondary btn-sm sketch-edge sketch-hover" href="/categories/<%= c.id %>/edit">
            <%- include('../partials/icon', { name: 'edit', size: 14 }) %> Editar
          </a>
          <form action="/categories/<%= c.id %>?_method=DELETE" method="POST" class="inline js-confirm-submit"
                data-confirm="Excluir a categoria <%= c.nome %>?">
            <button type="submit" class="btn btn-danger btn-sm sketch-edge sketch-hover">
              <%- include('../partials/icon', { name: 'trash', size: 14 }) %> Excluir
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>
