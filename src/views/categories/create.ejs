<h1><%= categoria ? 'Editar Categoria' : 'Registrar Nova Categoria' %></h1>

<form action="<%= categoria ? `/categories/${categoria.id}?_method=PUT` : '/categories' %>" method="POST" class="form form-narrow">
  <label for="nome">Nome</label>
  <input type="text" id="nome" name="nome" required value="<%= categoria?.nome ?? '' %>" />

  <label for="descricao">Descrição</label>
  <textarea id="descricao" name="descricao" rows="3"><%= categoria?.descricao ?? '' %></textarea>

  <label for="cor">Cor de identificação</label>
  <input type="color" id="cor" name="cor" value="<%= categoria?.cor ?? '#2563EB' %>" />

  <label for="tempoDesejadoMin">Tempo desejado por dia (minutos, opcional)</label>
  <input type="number" id="tempoDesejadoMin" name="tempoDesejadoMin" min="1"
         value="<%= categoria?.tempoDesejadoMin ?? '' %>" />

  <label for="duracaoPadraoMin">Duração padrão da atividade (minutos, opcional)</label>
  <input type="number" id="duracaoPadraoMin" name="duracaoPadraoMin" min="1"
         value="<%= categoria?.duracaoPadraoMin ?? '' %>" />
  <small class="muted">Ao registrar uma atividade nesta categoria, a hora de fim será sugerida a partir deste valor.</small>

  <label class="checkbox-label">
    <input type="checkbox" id="possuiValor" name="possuiValor"
           <%= categoria?.possuiValor ? 'checked' : '' %> />
    Esta categoria possui um valor numérico associado (ex.: custo, valor de depósito)
  </label>

  <div id="valorFields" class="<%= categoria?.possuiValor ? '' : 'hidden' %>">
    <label for="valorLabel">Rótulo do valor</label>
    <input type="text" id="valorLabel" name="valorLabel" maxlength="80"
           placeholder="Ex.: Custo da passagem (R$)" value="<%= categoria?.valorLabel ?? '' %>" />

    <label for="valorPadrao">Valor padrão (opcional)</label>
    <input type="number" id="valorPadrao" name="valorPadrao" min="0.01" step="0.01"
           value="<%= categoria?.valorPadrao ?? '' %>" />
    <small class="muted">Sugerido ao registrar uma atividade nesta categoria, mas pode ser alterado.</small>
  </div>

  <button type="submit" class="btn btn-primary"><%= categoria ? 'Salvar' : 'Registrar' %></button>
</form>

<script>
  (function () {
    var checkbox = document.getElementById('possuiValor');
    var fields = document.getElementById('valorFields');
    checkbox.addEventListener('change', function () {
      fields.classList.toggle('hidden', !checkbox.checked);
    });
  })();
</script>
