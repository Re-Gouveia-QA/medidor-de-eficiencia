<h1 class="home-greeting"><%= t('home.greeting', { name: userName }) %></h1>
<p class="muted home-date"><%= dataHoje %></p>

<% if (emAndamento) { %>
  <div class="card sketch-edge in-progress-card is-live sketch-in" style="--stagger-index: 0;">
    <div class="in-progress-status">
      <span class="live-dot" aria-hidden="true"></span>
      <%= t('home.inProgress.status', { categoria: emAndamento.category.nome }) %>
    </div>
    <strong class="in-progress-name"><%= emAndamento.nome %></strong>
    <span class="report-big-wrap">
      <span class="report-big in-progress-timer" data-started-at="<%= emAndamento.horaInicio.toISOString() %>">00:00</span>
      <svg class="stat-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
    <form action="/activities/<%= emAndamento.id %>/finish" method="POST">
      <details class="in-progress-details">
        <summary><%= t('home.inProgress.detailsToggle') %></summary>
        <div class="field">
          <label class="field-label" for="descricao"><%= t('activities.form.descriptionLabel') %></label>
          <div class="sketch-edge input-wrap">
            <textarea id="descricao" name="descricao" class="input" rows="3" placeholder="<%= t('activities.form.descriptionPlaceholder') %>"></textarea>
          </div>
        </div>
        <% if (emAndamento.category.possuiValor) { %>
          <div class="field">
            <label class="field-label" for="valor"><%= emAndamento.category.valorLabel || t('common.valueLabelDefault') %></label>
            <div class="sketch-edge input-wrap">
              <input type="number" id="valor" name="valor" class="input" min="0.01" step="0.01" placeholder="0.00"
                     value="<%= emAndamento.category.valorPadrao ?? '' %>" />
            </div>
          </div>
        <% } %>
      </details>
      <button type="submit" class="btn btn-primary sketch-edge sketch-hover">
        <%- include('../partials/icon', { name: 'check', size: 16 }) %> <%= t('home.inProgress.finish') %>
      </button>
    </form>
  </div>
  <script src="/js/in-progress-timer.js"></script>
<% } else if (categorias.length > 0) { %>
  <form action="/activities/start" method="POST" class="card sketch-edge in-progress-card form sketch-in" style="--stagger-index: 0;">
    <div class="card-heading">
      <%- include('../partials/icon', { name: 'clock', size: 20, color: 'var(--accent-blue)' }) %>
      <h2><%= t('home.startForm.heading') %></h2>
    </div>
    <div class="form-row">
      <div class="field">
        <div class="sketch-edge input-wrap">
          <input type="text" name="nome" class="input" required placeholder="<%= t('home.startForm.namePlaceholder') %>" autofocus />
        </div>
      </div>
      <div class="field">
        <div class="sketch-edge input-wrap">
          <select name="categoryId" class="select" required>
            <option value="" disabled selected><%= t('home.startForm.categoryPlaceholder') %></option>
            <% categorias.forEach((c) => { %>
              <option value="<%= c.id %>"><%= c.nome %></option>
            <% }) %>
          </select>
          <%- include('../partials/icon', { name: 'chevron-down', size: 16, color: 'var(--accent-blue)' }) %>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-primary sketch-edge sketch-hover">
      <%- include('../partials/icon', { name: 'plus', size: 16 }) %> <%= t('home.startForm.submit') %>
    </button>
  </form>
<% } %>

<h3 class=""><%= t('home.menu.heading') %></h3>

<div class="grid-menu">
  <a class="card sketch-edge sketch-hover sketch-in section-blue" style="--stagger-index: 0;" href="/activities/new">
    <%- include('../partials/icon', { name: 'plus', size: 26 }) %>
    <strong><%= t('home.menu.newActivity.title') %></strong>
    <span class="muted"><%= t('home.menu.newActivity.subtitle') %></span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-green" style="--stagger-index: 1;" href="/activities">
    <%- include('../partials/icon', { name: 'clock', size: 26 }) %>
    <strong><%= t('home.menu.viewActivities.title') %></strong>
    <span class="muted"><%= t('home.menu.viewActivities.subtitle') %></span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-yellow" style="--stagger-index: 2;" href="/reports">
    <%- include('../partials/icon', { name: 'star', size: 26 }) %>
    <strong><%= t('home.menu.reports.title') %></strong>
    <span class="muted"><%= t('home.menu.reports.subtitle') %></span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-red" style="--stagger-index: 3;" href="/categories">
    <%- include('../partials/icon', { name: 'tag', size: 26 }) %>
    <strong><%= t('home.menu.categories.title') %></strong>
    <span class="muted"><%= t('home.menu.categories.subtitle') %></span>
  </a>
</div>
