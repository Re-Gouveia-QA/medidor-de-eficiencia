<h1 class="home-greeting">Bem-vindo(a) de volta, <%= userName %></h1>
<p class="muted home-date"><%= dataHoje %></p>

<% if (emAndamento) { %>
  <div class="card sketch-edge in-progress-card is-live">
    <div class="in-progress-status">
      <span class="live-dot" aria-hidden="true"></span>
      Em andamento · <%= emAndamento.category.nome %>
    </div>
    <strong class="in-progress-name"><%= emAndamento.nome %></strong>
    <span class="report-big-wrap">
      <span class="report-big in-progress-timer" data-started-at="<%= emAndamento.horaInicio.toISOString() %>">00:00</span>
      <svg class="stat-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
    <form action="/activities/<%= emAndamento.id %>/finish" method="POST">
      <button type="submit" class="btn btn-primary sketch-edge sketch-hover">
        <%- include('../partials/icon', { name: 'check', size: 16 }) %> Finalizar
      </button>
    </form>
  </div>
  <script src="/js/in-progress-timer.js"></script>
<% } else if (categorias.length > 0) { %>
  <form action="/activities/start" method="POST" class="card sketch-edge in-progress-card form">
    <h2>O que você está fazendo agora?</h2>
    <div class="form-row">
      <div class="field">
        <div class="sketch-edge input-wrap">
          <input type="text" name="nome" class="input" required placeholder="Ex.: Reunião de equipe" autofocus />
        </div>
      </div>
      <div class="field">
        <div class="sketch-edge input-wrap">
          <select name="categoryId" class="select" required>
            <option value="" disabled selected>Categoria</option>
            <% categorias.forEach((c) => { %>
              <option value="<%= c.id %>"><%= c.nome %></option>
            <% }) %>
          </select>
          <%- include('../partials/icon', { name: 'chevron-down', size: 16, color: 'var(--accent-blue)' }) %>
        </div>
      </div>
    </div>
    <button type="submit" class="btn btn-primary sketch-edge sketch-hover">
      <%- include('../partials/icon', { name: 'plus', size: 16 }) %> Iniciar
    </button>
  </form>
<% } %>

<p class="muted">O que você quer fazer agora?</p>

<div class="grid-menu">
  <a class="card sketch-edge sketch-hover sketch-in section-blue" style="--stagger-index: 0;" href="/activities/new">
    <%- include('../partials/icon', { name: 'plus', size: 26 }) %>
    <strong>Registrar atividade</strong>
    <span class="muted">Anote o que você acabou de fazer</span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-green" style="--stagger-index: 1;" href="/activities">
    <%- include('../partials/icon', { name: 'clock', size: 26 }) %>
    <strong>Visualizar atividades</strong>
    <span class="muted">Liste e filtre seus registros</span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-yellow" style="--stagger-index: 2;" href="/reports">
    <%- include('../partials/icon', { name: 'star', size: 26 }) %>
    <strong>Relatórios</strong>
    <span class="muted">Dias registrados e tempo por categoria</span>
  </a>
  <a class="card sketch-edge sketch-hover sketch-in section-red" style="--stagger-index: 3;" href="/categories">
    <%- include('../partials/icon', { name: 'tag', size: 26 }) %>
    <strong>Categorias</strong>
    <span class="muted">Organize do seu jeito</span>
  </a>
</div>
