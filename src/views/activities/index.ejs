<div class="page-header">
  <%- include('../partials/page-header', { title: t('activities.index.title'), backHref: '/' }) %>
  <a class="btn btn-primary sketch-edge sketch-hover" href="/activities/new">
    <%- include('../partials/icon', { name: 'plus', size: 16 }) %> <%= t('activities.newActivityLabel') %>
  </a>
</div>

<form method="GET" action="/activities" class="filters">
  <div class="field">
    <label class="field-label" for="inicio"><%= t('activities.filters.fromLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="inicio" name="inicio" class="input" value="<%= filtros.inicio %>" />
    </div>
  </div>
  <div class="field">
    <label class="field-label" for="fim"><%= t('activities.filters.toLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="fim" name="fim" class="input" value="<%= filtros.fim %>" />
    </div>
  </div>
  <div class="field">
    <label class="field-label" for="categoria"><%= t('activities.filters.categoryLabel') %></label>
    <div class="sketch-edge input-wrap">
      <select id="categoria" name="categoria" class="select">
        <option value=""><%= t('activities.filters.allCategories') %></option>
        <% categorias.forEach((c) => { %>
          <option value="<%= c.id %>" <%= filtros.categoria === c.id ? 'selected' : '' %>><%= c.nome %></option>
        <% }) %>
      </select>
      <%- include('../partials/icon', { name: 'chevron-down', size: 16, color: 'var(--ink-soft)' }) %>
    </div>
  </div>
  <button type="submit" class="btn btn-secondary sketch-edge sketch-hover">
    <%- include('../partials/icon', { name: 'filter', size: 16 }) %> <%= t('activities.filters.submit') %>
  </button>
</form>

<% if (atividades.length === 0) { %>
  <p class="muted"><%= t('activities.index.empty') %></p>
<% } else { %>
  <ul class="list">
    <% atividades.forEach((a, i) => { %>
      <li class="list-item sketch-edge sketch-in" style="--stagger-index: <%= i %>;">
        <span class="color-dot" style="background: <%= a.category.cor %>" aria-hidden="true"></span>
        <div class="list-item-body">
          <strong><%= a.nome %></strong>
          <span class="muted">
            <%= a.data.toISOString().slice(0, 10).split('-').reverse().join('/') %> ·
            <% if (a.horaFim) { %>
              <%= formatTime(a.horaInicio) %>–<%= formatTime(a.horaFim) %> · <%= formatMinutes(a.duracaoMin) %> ·
            <% } else { %>
              <span class="badge badge-blue"><%= t('activities.index.inProgressBadge') %></span> ·
            <% } %>
            <%= a.category.nome %>
          </span>
          <% if (a.category.possuiValor && a.valor != null) { %>
            <span class="muted"><%= a.category.valorLabel || t('common.valueLabelDefault') %>: <%= formatNumber(a.valor) %></span>
          <% } %>
          <% if (a.descricao) { %><span class="muted"><%= a.descricao %></span><% } %>
        </div>
        <div class="actions">
          <button type="button" class="icon-btn sketch-edge sketch-hover btn-secondary js-view-activity-details" aria-label="<%= t('activities.index.viewDetailsAriaLabel') %>">
            <%- include('../partials/icon', { name: 'eye', size: 20 }) %>
          </button>
          <a class="icon-btn sketch-edge sketch-hover btn-secondary" href="/activities/<%= a.id %>/edit" aria-label="<%= t('activities.index.editAriaLabel') %>">
            <%- include('../partials/icon', { name: 'edit', size: 20 }) %>
          </a>
          <form action="/activities/<%= a.id %>?_method=DELETE" method="POST" class="inline js-confirm-submit"
                data-confirm="<%= t('activities.index.deleteConfirm') %>">
            <button type="submit" class="icon-btn sketch-edge sketch-hover btn-danger" aria-label="<%= t('activities.index.deleteAriaLabel') %>">
              <%- include('../partials/icon', { name: 'trash', size: 20 }) %>
            </button>
          </form>
        </div>
        <template class="activity-detail-template">
          <h3 class="activity-detail-name"><%= a.nome %></h3>
          <p class="activity-detail-meta">
            <span class="color-dot" style="background: <%= a.category.cor %>" aria-hidden="true"></span>
            <%= a.category.nome %>
          </p>
          <p class="muted">
            <%= a.data.toISOString().slice(0, 10).split('-').reverse().join('/') %>
            <% if (a.horaFim) { %>
              · <%= formatTime(a.horaInicio) %>–<%= formatTime(a.horaFim) %> · <%= formatMinutes(a.duracaoMin) %>
            <% } else { %>
              · <span class="badge badge-blue"><%= t('activities.index.inProgressBadge') %></span>
            <% } %>
          </p>
          <% if (a.category.possuiValor && a.valor != null) { %>
            <p><strong><%= a.category.valorLabel || t('common.valueLabelDefault') %>:</strong> <%= formatNumber(a.valor) %></p>
          <% } %>
          <% if (a.descricao) { %>
            <p><%= a.descricao %></p>
          <% } %>
        </template>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('../partials/activity-detail-modal') %>
