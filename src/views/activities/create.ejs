<%- include('../partials/page-header', { title: atividade ? 'Editar Atividade' : 'Nova Atividade', backHref: '/activities' }) %>

<form id="activityForm" action="<%= atividade ? `/activities/${atividade.id}?_method=PUT` : '/activities' %>"
      method="POST" class="form form-narrow" data-editing="<%= atividade ? 'true' : 'false' %>">
  <div class="field">
    <label class="field-label" for="nome">Nome da atividade</label>
    <div class="sketch-edge input-wrap">
      <input type="text" id="nome" name="nome" class="input" required value="<%= atividade?.nome ?? '' %>" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="categoryId">Categoria</label>
    <div class="sketch-edge input-wrap">
      <select id="categoryId" name="categoryId" class="select" required>
        <% categorias.forEach((c) => { %>
          <option value="<%= c.id %>" <%= atividade?.categoryId === c.id ? 'selected' : '' %>
            data-duracao-padrao-min="<%= c.duracaoPadraoMin ?? '' %>"
            data-possui-valor="<%= c.possuiValor %>"
            data-valor-label="<%= c.valorLabel ?? 'Valor' %>"
            data-valor-padrao="<%= c.valorPadrao ?? '' %>"
          ><%= c.nome %></option>
        <% }) %>
      </select>
      <%- include('../partials/icon', { name: 'chevron-down', size: 16, color: 'var(--ink-soft)' }) %>
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="data">Data</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'calendar', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="date" id="data" name="data" class="input" required
             value="<%= atividade ? atividade.data.toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10) %>" />
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label class="field-label" for="horaInicio">Hora de início</label>
      <div class="sketch-edge input-wrap">
        <input type="time" id="horaInicio" name="horaInicio" class="input" required
               value="<%= atividade ? atividade.horaInicio.toISOString().slice(11, 16) : '' %>" />
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="horaFim">Hora de fim</label>
      <div class="sketch-edge input-wrap">
        <input type="time" id="horaFim" name="horaFim" class="input" required
               value="<%= atividade ? atividade.horaFim.toISOString().slice(11, 16) : '' %>" />
      </div>
    </div>
  </div>

  <div id="valorField" class="field hidden">
    <label class="field-label" for="valor" id="valorLabelText">Valor</label>
    <div class="sketch-edge input-wrap">
      <input type="number" id="valor" name="valor" class="input" min="0.01" step="0.01"
             value="<%= atividade?.valor ?? '' %>" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="descricao">Descrição / observações (opcional)</label>
    <div class="sketch-edge input-wrap">
      <textarea id="descricao" name="descricao" class="input" rows="4"><%= atividade?.descricao ?? '' %></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover"><%= atividade ? 'Salvar' : 'Registrar' %></button>
</form>

<script src="/js/activity-form.js"></script>
