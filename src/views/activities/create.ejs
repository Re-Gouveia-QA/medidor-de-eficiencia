<%- include('../partials/page-header', { title: atividade ? t('activities.form.editTitle') : t('activities.form.newTitle'), backHref: '/activities' }) %>

<div class="card sketch-edge form-narrow form-card">
<form id="activityForm" action="<%= atividade ? `/activities/${atividade.id}?_method=PUT` : '/activities' %>"
      method="POST" class="form" data-editing="<%= atividade ? 'true' : 'false' %>">
  <div class="field sketch-in" style="--stagger-index: 0;">
    <label class="field-label" for="nome"><%= t('activities.form.nameLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="text" id="nome" name="nome" class="input" required placeholder="<%= t('activities.form.namePlaceholder') %>" value="<%= atividade?.nome ?? '' %>" />
    </div>
  </div>

  <div class="field sketch-in" style="--stagger-index: 1;">
    <label class="field-label" for="categoryId"><%= t('activities.filters.categoryLabel') %></label>
    <div class="sketch-edge input-wrap">
      <select id="categoryId" name="categoryId" class="select" required>
        <% categorias.forEach((c) => { %>
          <option value="<%= c.id %>" <%= atividade?.categoryId === c.id ? 'selected' : '' %>
            data-duracao-padrao-min="<%= c.duracaoPadraoMin ?? '' %>"
            data-possui-valor="<%= c.possuiValor %>"
            data-valor-label="<%= c.valorLabel ?? t('common.valueLabelDefault') %>"
            data-valor-padrao="<%= c.valorPadrao ?? '' %>"
          ><%= c.nome %></option>
        <% }) %>
      </select>
      <%- include('../partials/icon', { name: 'chevron-down', size: 16, color: 'var(--accent-green)' }) %>
    </div>
  </div>

  <div class="field sketch-in" style="--stagger-index: 2;">
    <label class="field-label" for="data"><%= t('activities.form.dateLabel') %></label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="data" name="data" class="input" required
             value="<%= atividade ? atividade.data.toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10) %>" />
    </div>
  </div>

  <div class="form-row sketch-in" style="--stagger-index: 3;">
    <div class="field">
      <label class="field-label" for="horaInicio"><%= t('activities.form.startTimeLabel') %></label>
      <div class="sketch-edge input-wrap">
        <input type="time" id="horaInicio" name="horaInicio" class="input" required
               value="<%= atividade ? formatTime(atividade.horaInicio) : '' %>" />
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="horaFim"><%= t('activities.form.endTimeLabel') %></label>
      <div class="sketch-edge input-wrap">
        <input type="time" id="horaFim" name="horaFim" class="input" required
               value="<%= atividade && atividade.horaFim ? formatTime(atividade.horaFim) : '' %>" />
      </div>
    </div>
  </div>

  <div id="valorField" class="field hidden">
    <label class="field-label" for="valor" id="valorLabelText"><%= t('common.valueLabelDefault') %></label>
    <div class="sketch-edge input-wrap">
      <input type="number" id="valor" name="valor" class="input" min="0.01" step="0.01" placeholder="0.00"
             value="<%= atividade?.valor ?? '' %>" />
    </div>
  </div>

  <div class="field sketch-in" style="--stagger-index: 4;">
    <label class="field-label" for="descricao"><%= t('activities.form.descriptionLabel') %></label>
    <div class="sketch-edge input-wrap">
      <textarea id="descricao" name="descricao" class="input" rows="4" placeholder="<%= t('activities.form.descriptionPlaceholder') %>"><%= atividade?.descricao ?? '' %></textarea>
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover sketch-in" style="--stagger-index: 5;"><%= atividade ? t('common.submitSave') : t('common.submitNew') %></button>
</form>
</div>

<script src="/js/activity-form.js"></script>
