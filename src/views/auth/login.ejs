<h1 class="auth-title">Alvos do Sistema</h1>
<p class="auth-subtitle">Registre seu dia. Entenda seu tempo.</p>

<a class="btn btn-google" href="/auth/google/callback" aria-disabled="true" title="Disponível na Fase 5">
  Entrar com Google
</a>

<div class="divider"><span>ou</span></div>

<form action="/login" method="POST" class="form">
  <label for="email">E-mail</label>
  <input type="email" id="email" name="email" required autocomplete="email" />

  <label for="senha">Senha</label>
  <input type="password" id="senha" name="senha" required autocomplete="current-password" />

  <button type="submit" class="btn btn-primary">Entrar</button>
</form>

<p class="auth-footer">Não tem conta? <a href="/register">Criar conta</a></p>
