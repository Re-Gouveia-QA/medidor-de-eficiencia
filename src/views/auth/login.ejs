<h1 class="auth-title">Entrar</h1>
<p class="auth-subtitle">Registre seu dia. Entenda seu tempo.</p>

<a class="btn btn-google sketch-edge sketch-hover" href="/auth/google">
  <%- include('../partials/icon', { name: 'user', size: 16 }) %> Entrar com Google
</a>

<div class="divider"><span>ou</span></div>

<form action="/login" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="email">E-mail</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'mail', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="senha">Senha</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="senha" name="senha" class="input" required autocomplete="current-password" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover">Entrar</button>
</form>

<p class="auth-footer">Não tem conta? <a href="/register">Criar conta</a></p>
