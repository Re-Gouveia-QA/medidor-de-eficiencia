<h1 class="auth-title">Criar conta</h1>
<p class="auth-subtitle">Comece a registrar suas atividades hoje.</p>

<a class="btn btn-google sketch-edge sketch-hover" href="/auth/google">
  <%- include('../partials/icon', { name: 'user', size: 16 }) %> Continuar com Google
</a>

<div class="divider"><span>ou</span></div>

<form action="/register" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="nome">Nome</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'user', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="text" id="nome" name="nome" class="input" required autocomplete="name" placeholder="Seu nome completo" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="email">E-mail</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'mail', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="seu@email.com" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="senha">Senha (mínimo 8 caracteres)</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="senha" name="senha" class="input" required minlength="8" autocomplete="new-password" placeholder="Mínimo 8 caracteres" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover">Criar conta</button>
</form>

<p class="auth-footer">Já tem conta? <a href="/login">Entrar</a></p>
