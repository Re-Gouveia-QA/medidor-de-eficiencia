<h1 class="auth-title">Criar conta</h1>
<p class="auth-subtitle">Comece a registrar suas atividades hoje.</p>

<a class="btn btn-google" href="/auth/google">
  Continuar com Google
</a>

<div class="divider"><span>ou</span></div>

<form action="/register" method="POST" class="form">
  <label for="nome">Nome</label>
  <input type="text" id="nome" name="nome" required autocomplete="name" />

  <label for="email">E-mail</label>
  <input type="email" id="email" name="email" required autocomplete="email" />

  <label for="senha">Senha (mínimo 8 caracteres)</label>
  <input type="password" id="senha" name="senha" required minlength="8" autocomplete="new-password" />

  <button type="submit" class="btn btn-primary">Criar conta</button>
</form>

<p class="auth-footer">Já tem conta? <a href="/login">Entrar</a></p>
