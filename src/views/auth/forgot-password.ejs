<h1 class="auth-title"><%= t('auth.forgotPassword.title') %></h1>
<p class="auth-subtitle"><%= t('auth.forgotPassword.subtitle') %></p>

<form action="/forgot-password" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="email"><%= t('auth.common.emailLabel') %></label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'mail', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="<%= t('auth.common.emailPlaceholder') %>" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover"><%= t('auth.forgotPassword.submit') %></button>
</form>

<p class="auth-footer"><a href="/login"><%= t('auth.common.backToLogin') %></a></p>
