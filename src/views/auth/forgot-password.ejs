<h1 class="auth-title">Esqueceu a senha?</h1>
<p class="auth-subtitle">Informe seu e-mail para receber instruções de redefinição.</p>

<form action="/forgot-password" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="email">E-mail</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'mail', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="email" id="email" name="email" class="input" required autocomplete="email" placeholder="seu@email.com" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover">Enviar instruções</button>
</form>

<p class="auth-footer"><a href="/login">Voltar para o login</a></p>
