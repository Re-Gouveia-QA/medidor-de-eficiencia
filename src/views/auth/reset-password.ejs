<h1 class="auth-title"><%= t('auth.resetPassword.title') %></h1>
<p class="auth-subtitle"><%= t('auth.resetPassword.subtitle') %></p>

<form action="/reset-password/<%= token %>" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="senha"><%= t('auth.resetPassword.passwordLabel') %></label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="senha" name="senha" class="input" required minlength="8" autocomplete="new-password" placeholder="<%= t('auth.common.minPasswordPlaceholder') %>" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="confirmarSenha"><%= t('auth.resetPassword.confirmPasswordLabel') %></label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="confirmarSenha" name="confirmarSenha" class="input" required minlength="8" autocomplete="new-password" placeholder="<%= t('auth.resetPassword.confirmPasswordPlaceholder') %>" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover"><%= t('auth.resetPassword.submit') %></button>
</form>

<p class="auth-footer"><a href="/login"><%= t('auth.common.backToLogin') %></a></p>
