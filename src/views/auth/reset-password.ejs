<h1 class="auth-title">Redefinir senha</h1>
<p class="auth-subtitle">Escolha uma nova senha para sua conta.</p>

<form action="/reset-password/<%= token %>" method="POST" class="form">
  <div class="field">
    <label class="field-label" for="senha">Nova senha (mínimo 8 caracteres)</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="senha" name="senha" class="input" required minlength="8" autocomplete="new-password" placeholder="Mínimo 8 caracteres" />
    </div>
  </div>

  <div class="field">
    <label class="field-label" for="confirmarSenha">Confirmar nova senha</label>
    <div class="sketch-edge input-wrap">
      <%- include('../partials/icon', { name: 'lock', size: 17, color: 'var(--ink-soft)' }) %>
      <input type="password" id="confirmarSenha" name="confirmarSenha" class="input" required minlength="8" autocomplete="new-password" placeholder="Repita a nova senha" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary sketch-edge sketch-hover">Redefinir senha</button>
</form>

<p class="auth-footer"><a href="/login">Voltar para o login</a></p>
