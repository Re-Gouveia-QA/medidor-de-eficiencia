<%- include('../partials/page-header', { title: 'Relatório', backHref: '/' }) %>

<form method="GET" action="/reports" class="filters">
  <div class="field">
    <label class="field-label" for="inicio">De</label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="inicio" name="inicio" class="input" value="<%= filtros.inicio %>" required />
    </div>
  </div>
  <div class="field">
    <label class="field-label" for="fim">Até</label>
    <div class="sketch-edge input-wrap">
      <input type="date" id="fim" name="fim" class="input" value="<%= filtros.fim %>" required />
    </div>
  </div>
  <button type="submit" class="btn btn-secondary sketch-edge sketch-hover">Aplicar período</button>
</form>

<div class="report-cards">
  <div class="card sketch-edge report-card sketch-in" style="--tilt: -0.6deg; --stagger-index: 0; transform: rotate(var(--tilt));">
    <span class="report-big-wrap">
      <span class="report-big"><%= relatorio.diasRegistrados %>/<%= relatorio.diasNoPeriodo %></span>
      <svg class="stat-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
    <span class="muted">dias registrados</span>
  </div>
  <div class="card sketch-edge report-card sketch-in" style="--tilt: 0.6deg; --stagger-index: 1; transform: rotate(var(--tilt));">
    <span class="report-big-wrap">
      <span class="report-big"><%= relatorio.totalFormatado %></span>
      <svg class="stat-underline" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M4 12 Q 50 3, 100 11 T 196 9" pathLength="1" />
      </svg>
    </span>
    <span class="muted">total de horas registradas no período</span>
  </div>
</div>

<h2>Tempo por categoria</h2>
<% if (relatorio.distribuicao.length === 0) { %>
  <p class="muted">Nenhuma atividade registrada no período selecionado.</p>
<% } else { %>
  <div class="card sketch-edge">
    <ul class="bars">
      <% relatorio.distribuicao.forEach((d, i) => { %>
        <li class="sketch-in" style="--stagger-index: <%= i %>;">
          <div class="bar-label">
            <span><span class="color-dot" style="background: <%= d.cor %>" aria-hidden="true"></span> <%= d.categoria %></span>
            <span class="muted"><%= d.totalFormatado %> (<%= d.percentual %>%)</span>
          </div>
          <div class="bar-track">
            <div class="bar-fill" style="--pct: <%= d.percentual / 100 %>; background: <%= d.cor %>"></div>
          </div>
        </li>
      <% }) %>
    </ul>
  </div>
<% } %>

<h2>Valor por categoria</h2>
<% if (seriesValor.length === 0) { %>
  <p class="muted">Nenhuma categoria com valor registrado no período selecionado.</p>
<% } else { %>
  <% seriesValor.forEach((serie, i) => { %>
    <div class="card sketch-edge sketch-in line-chart-card" style="--stagger-index: <%= i %>;">
      <div class="card-heading">
        <span class="color-dot" style="background: <%= serie.cor %>" aria-hidden="true"></span>
        <h3 class="card-title"><%= serie.categoria %> <span class="muted">— <%= serie.valorLabel %></span></h3>
      </div>
      <svg class="line-chart" viewBox="0 0 600 200" preserveAspectRatio="none" role="img"
           aria-label="Gráfico de linha de <%= serie.valorLabel %> ao longo do tempo para <%= serie.categoria %>, variando de <%= formatNumber(serie.geometry.minY) %> a <%= formatNumber(serie.geometry.maxY) %>">
        <% if (serie.geometry.points) { %>
          <polyline points="<%= serie.geometry.points %>" pathLength="1" style="stroke: <%= serie.cor %>" />
        <% } %>
        <% serie.pontos.forEach((p, j) => { %>
          <circle cx="<%= serie.geometry.circles[j].x %>" cy="<%= serie.geometry.circles[j].y %>" r="5" style="fill: <%= serie.cor %>">
            <title><%= p.nome %>: <%= formatNumber(p.valor) %> em <%= formatTime(p.horaInicio) %></title>
          </circle>
        <% }) %>
      </svg>
      <div class="line-chart-meta">
        <span>Mín.: <%= formatNumber(serie.geometry.minY) %></span>
        <span>Máx.: <%= formatNumber(serie.geometry.maxY) %></span>
      </div>
    </div>
  <% }) %>
<% } %>
