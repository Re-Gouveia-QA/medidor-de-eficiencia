# Ambiente
NODE_ENV=development
PORT=3000

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medidor_eficiencia?schema=public"

# Sessão (RNF02) — gere um valor forte: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-em-producao

# Google OAuth 2.0 (RF03 — Fase 5 do roadmap)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
