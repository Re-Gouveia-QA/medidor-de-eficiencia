# Ambiente
# No Railway: definir NODE_ENV=production nas variáveis do serviço (não é injetado automaticamente).
NODE_ENV=development
# No Railway: PORT é injetado automaticamente pela plataforma — não precisa (nem deve) ser definido manualmente.
PORT=3000

# Banco de dados (PostgreSQL)
# No Railway: ao adicionar o plugin PostgreSQL, use a referência ${{Postgres.DATABASE_URL}} nas
# variáveis do serviço web — não copiar o valor manualmente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medidor_eficiencia?schema=public"

# Sessão (RNF02) — gere um valor forte: openssl rand -hex 32
SESSION_SECRET=troque-este-valor-em-producao

# Google OAuth 2.0 (RF03 — Fase 5 do roadmap)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# No Railway: usar o domínio público gerado pelo serviço, ex.: https://<seu-app>.up.railway.app/auth/google/callback
# (também precisa ser cadastrado como URI de redirecionamento autorizado no Google Cloud Console)
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Recuperação de senha — envio de e-mail via API HTTP da Brevo (não SMTP: a porta SMTP trava/é
# bloqueada em algumas plataformas de hospedagem, ex.: Railway). Gere a chave em Settings ->
# SMTP & API -> API Keys -> "Generate a new API key" no painel da Brevo (não é a mesma chave SMTP).
# Sem essas variáveis, o link de redefinição só é logado no console (útil em dev, não em produção).
BREVO_API_KEY=
SMTP_FROM="Sketch your time <no-reply@example.com>"

# URL pública da aplicação, usada para montar o link de redefinição de senha no e-mail.
# No Railway: usar o domínio público gerado pelo serviço, ex.: https://<seu-app>.up.railway.app
APP_URL=http://localhost:3000
