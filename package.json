{
  "name": "medidor-de-eficiencia",
  "version": "0.1.0",
  "description": "Sistema web para registro de atividades e análise de eficiência pessoal (MVP)",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run copy:assets",
    "copy:assets": "cpy 'src/views/**/*' dist/views --parents=false --cwd=. && cpy 'public/**/*' dist/public",
    "start": "prisma migrate deploy && node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.{ts,ejs}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "dotenv": "16.6.1",
    "ejs": "3.1.10",
    "express": "4.22.2",
    "express-async-errors": "3.1.1",
    "express-ejs-layouts": "2.5.1",
    "express-rate-limit": "8.5.2",
    "express-session": "1.19.0",
    "google-auth-library": "10.9.0",
    "helmet": "8.3.0",
    "js-yaml": "5.2.1",
    "method-override": "3.0.0",
    "pg": "8.22.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "4.17.25",
    "@types/express-ejs-layouts": "2.5.4",
    "@types/express-session": "1.19.0",
    "@types/js-yaml": "4.0.9",
    "@types/method-override": "0.0.35",
    "@types/node": "20.19.43",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "cpy-cli": "5.0.0",
    "eslint": "8.57.1",
    "prettier": "3.9.5",
    "prisma": "5.22.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
